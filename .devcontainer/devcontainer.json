{
  "name": "Стартовий сервіс курсу",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "command -v make >/dev/null || (sudo apt-get update && sudo apt-get install -y make); make install",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Сервіс",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
